{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "exchanges": [
    {
      "name": "roomee_events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "gateway_exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "auth_queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "notification_queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },

    {
      "name": "hotel_queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },

    {
      "name": "media_queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    }
  ],
  "bindings": [
    {
      "source": "roomee_events",
      "vhost": "/",
      "destination": "auth_queue",
      "destination_type": "queue",
      "routing_key": "roomee.auth.*"
    },
    {
      "source": "roomee_events",
      "vhost": "/",
      "destination": "notification_queue",
      "destination_type": "queue",
      "routing_key": "roomee.notification.*"
    },

    {
      "source": "roomee_events",
      "vhost": "/",
      "destination": "hotel_queue",
      "destination_type": "queue",
      "routing_key": "roomee.hotel.*"
    },

    {
      "source": "roomee_events",
      "vhost": "/",
      "destination": "media_queue",
      "destination_type": "queue",
      "routing_key": "roomee.media.*"
    }
  ]
}
